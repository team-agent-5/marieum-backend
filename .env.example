# ───── 서버 ─────
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ───── Database (pgvector 포함) ─────
# docker-compose up -d 하면 아래 값으로 자동 세팅됨
DATABASE_URL=postgresql+asyncpg://aac:aac@localhost:5432/aac

# ───── GPU/ML 서버 ─────
# Mock 서버: scripts/mock_asr_server.py 띄우면 http://localhost:9001
# 실 서버 붙이면 http://ML_HOST:8001
ML_ASR_URL=http://localhost:9001
ML_ASR_TIMEOUT_SEC=3.0

# ML ASR WebSocket URL (none이면 Mock ML 서버 fallback)
ML_ASR_WS_URL=ws://10.1.2.11:8001/asr-stream
# 기존 MARIEUM_ML_ASR_WS_URL 이름도 지원. ML 없이 연동 시험 시 ws://127.0.0.1:19001/asr-stream

# 선택 엔드포인트 (ML팀이 올렸을 때만 설정)
ML_INTENT_URL=
ML_REFINE_URL=

# ───── LLM (Groq) ─────
# https://console.groq.com/keys 에서 발급
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SEC=1.5

# ───── 임베딩 모델 ─────
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ───── 가드레일 ─────
INTENT_CONFIDENCE_THRESHOLD=0.60
RETRY_MAX_ATTEMPTS=3

# ───── JWT (HS256, 리프레시 없음) ─────
# 운영 시 반드시 32바이트 이상 랜덤 값으로 교체: `openssl rand -hex 32`
JWT_SECRET=dev-secret-change-me-in-production-32bytes-min
JWT_ALGORITHM=HS256

# 실시간 비개인화 교정: Anthropic Haiku (키는 배포 환경의 .env에 설정)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Copa 가상 키: BASE_URL=https://copa.codyssey.kr, MODEL=claude-haiku-4
ANTHROPIC_TIMEOUT_SEC=1.5
MARIEUM_STREAMING_LLM_ENABLED=true

# Anthropic (Claude) — accuracy mode (D1+)
# ANTHROPIC_API_KEY 는 위 streaming 섹션과 공유 (unified key management)
ACCURACY_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ACCURACY_ANTHROPIC_BASE_URL=https://copa.codyssey.kr/v1
ACCURACY_ANTHROPIC_TIMEOUT_SEC=1.5
